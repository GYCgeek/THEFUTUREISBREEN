<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SB64 Youth AI Listening Lab — Introduction</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,750&family=Archivo:wght@400;600;750;850&family=Spline+Sans+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #12201a;
    --muted: #4d5e55;
    --green: #08775d;
    --lime: #c9ff5b;
    --sky: #c9edff;
    --paper: #f4f1e8;
    --font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
    --font-sans: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    --font-mono: 'Spline Sans Mono', ui-monospace, 'Cascadia Mono', monospace;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    overflow: hidden;
    color: var(--ink);
    font-family: var(--font-sans);
    background:
      radial-gradient(900px 520px at 88% -6%, #d9ffa1 0%, transparent 58%),
      radial-gradient(720px 500px at -12% 30%, #cdeadf 0%, transparent 55%),
      radial-gradient(640px 460px at 70% 105%, #cfe9f8 0%, transparent 52%),
      var(--paper);
  }

  .slide {
    position: absolute;
    inset: 0;
    display: none;
    overflow-y: auto;
    padding: 5vh 6vw 11vh;
  }
  .slide.is-active { display: flex; animation: slide-in .45s cubic-bezier(.22,1,.36,1); }
  @keyframes slide-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  /* margin:auto centers when content fits and keeps the top reachable when it scrolls */
  .slide-inner { width: 100%; max-width: 1060px; margin: auto; }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: clamp(.6rem, 1.1vw, .74rem);
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--green);
  }
  .kicker::before { content: ""; width: 28px; height: 2px; background: var(--green); }

  h1 {
    margin: .35em 0 .25em;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(2.1rem, 5.6vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -.015em;
  }
  h1 em { font-style: italic; color: var(--green); }
  .sub {
    max-width: 56ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(.95rem, 1.7vw, 1.22rem);
    line-height: 1.55;
  }
  .sub strong { color: var(--ink); }

  .cards { display: grid; gap: 14px; margin-top: 30px; }
  .cards.cols-2 { grid-template-columns: 1fr 1fr; }
  .cards.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
  .card {
    padding: 18px 20px;
    border: 1px solid #12201a1f;
    border-radius: 18px;
    background: #fffefbd9;
  }
  .card .tag {
    display: inline-block;
    margin-bottom: 9px;
    padding: 4px 10px;
    border-radius: 99px;
    background: #08775d14;
    font-family: var(--font-mono);
    font-size: clamp(.55rem, .95vw, .64rem);
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--green);
  }
  .card .tag.is-lime { background: var(--lime); color: var(--ink); }
  .card .tag.is-sky { background: var(--sky); color: var(--ink); }
  .card h3 {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 1.9vw, 1.34rem);
    font-weight: 750;
    line-height: 1.15;
  }
  .card p { margin: 0; color: var(--muted); font-size: clamp(.8rem, 1.35vw, .95rem); line-height: 1.5; }
  .card p strong { color: var(--ink); }

  .stat { padding: 20px; }
  .stat .num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.7rem);
    font-weight: 750;
    line-height: 1;
    color: var(--green);
  }
  .stat .what { display: block; margin-top: 8px; color: var(--muted); font-size: clamp(.76rem, 1.3vw, .92rem); line-height: 1.45; }

  .punch {
    margin-top: 26px;
    padding: 18px 22px;
    border-left: 4px solid var(--green);
    border-radius: 0 16px 16px 0;
    background: #08775d0d;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    font-weight: 600;
    font-style: italic;
    line-height: 1.35;
  }
  .punch strong { color: var(--green); font-style: normal; }

  .steps { display: grid; gap: 10px; margin-top: 28px; counter-reset: step; }
  .step {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 13px 18px;
    border: 1px solid #12201a1c;
    border-radius: 14px;
    background: #fffefbd9;
  }
  .step::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 600;
    color: var(--green);
  }
  .step strong { font-size: clamp(.88rem, 1.5vw, 1.05rem); }
  .step span { color: var(--muted); font-size: clamp(.78rem, 1.3vw, .92rem); }

  .timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 30px; }
  .week {
    position: relative;
    padding: 22px 24px;
    border-radius: 20px;
    border: 1px solid #12201a1f;
    background: #fffefbd9;
  }
  .week.is-now { border: 2px solid var(--green); }
  .week .when {
    font-family: var(--font-mono);
    font-size: clamp(.58rem, 1vw, .68rem);
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--green);
  }
  .week h3 { margin: 8px 0 10px; font-family: var(--font-display); font-size: clamp(1.2rem, 2.4vw, 1.7rem); font-weight: 750; }
  .week ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: clamp(.8rem, 1.35vw, .95rem); line-height: 1.55; display: grid; gap: 5px; }
  .week .now-chip {
    position: absolute;
    top: -12px;
    right: 18px;
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--lime);
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .paper-parts { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 28px; }
  .paper-part {
    padding: 14px 13px;
    border: 1px solid #12201a1f;
    border-radius: 14px;
    background: #fffefbd9;
  }
  .paper-part .roman { font-family: var(--font-mono); font-size: .62rem; font-weight: 600; letter-spacing: .1em; color: var(--green); text-transform: uppercase; }
  .paper-part h4 { margin: 6px 0 4px; font-family: var(--font-display); font-size: clamp(.88rem, 1.5vw, 1.05rem); font-weight: 750; line-height: 1.1; }
  .paper-part p { margin: 0; color: var(--muted); font-size: clamp(.66rem, 1.1vw, .78rem); line-height: 1.42; }

  .join-block { display: flex; align-items: center; gap: 34px; margin-top: 32px; flex-wrap: wrap; }
  .join-code {
    padding: 22px 30px;
    border-radius: 22px;
    background: var(--ink);
    color: #fff;
  }
  .join-code .lbl { display: block; font-family: var(--font-mono); font-size: .62rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #9fc0b2; }
  .join-code .url { display: block; margin-top: 8px; font-family: var(--font-mono); font-size: clamp(.95rem, 2.1vw, 1.4rem); font-weight: 600; color: var(--lime); }

  .foot-src {
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: clamp(.52rem, .95vw, .62rem);
    letter-spacing: .05em;
    color: #4d5e55b0;
    text-transform: uppercase;
  }

  /* chrome */
  .deck-progress { position: fixed; top: 0; left: 0; right: 0; height: 4px; background: #12201a14; z-index: 10; }
  .deck-progress span { display: block; height: 100%; background: var(--green); transition: width .35s cubic-bezier(.22,1,.36,1); }
  .deck-hud {
    position: fixed;
    bottom: 18px;
    right: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
  }
  .deck-hud button {
    width: 40px;
    height: 40px;
    border: 1px solid #12201a2c;
    border-radius: 99px;
    background: #fffefbd9;
    color: var(--ink);
    font-size: 1rem;
    font-family: var(--font-sans);
    cursor: pointer;
  }
  .deck-hud button:hover { border-color: var(--green); color: var(--green); }
  .deck-count { font-family: var(--font-mono); font-size: .68rem; font-weight: 600; color: var(--muted); }
  .deck-brand {
    position: fixed;
    bottom: 22px;
    left: 24px;
    z-index: 10;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .cards.cols-2, .cards.cols-3, .timeline { grid-template-columns: 1fr; }
    .paper-parts { grid-template-columns: 1fr 1fr; }
    .slide { padding: 4vh 6vw 13vh; }
  }
  @media print {
    body { overflow: visible; background: #fff; }
    .slide { position: static; display: flex !important; min-height: 100vh; break-after: page; }
    .deck-progress, .deck-hud, .deck-brand { display: none; }
  }
</style>
</head>

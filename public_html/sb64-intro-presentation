<script>
  const slides = [...document.querySelectorAll('.slide')];
  const bar = document.getElementById('bar');
  const count = document.getElementById('count');
  let index = Math.min(slides.length - 1, Math.max(0, (parseInt(location.hash.slice(1), 10) || 1) - 1));

  function show(i) {
    index = Math.min(slides.length - 1, Math.max(0, i));
    slides.forEach((slide, n) => slide.classList.toggle('is-active', n === index));
    bar.style.width = `${((index + 1) / slides.length) * 100}%`;
    count.textContent = `${index + 1} / ${slides.length}`;
    history.replaceState(null, '', `#${index + 1}`);
  }

  document.getElementById('next').addEventListener('click', () => show(index + 1));
  document.getElementById('prev').addEventListener('click', () => show(index - 1));
  document.addEventListener('keydown', (event) => {
    if (['ArrowRight', ' ', 'PageDown'].includes(event.key)) { event.preventDefault(); show(index + 1); }
    if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); show(index - 1); }
    if (event.key === 'Home') show(0);
    if (event.key === 'End') show(slides.length - 1);
  });

  // Tap/click on the right or left third of the screen also advances (projector remote friendly).
  document.addEventListener('click', (event) => {
    if (event.target.closest('button, a')) return;
    const x = event.clientX / window.innerWidth;
    if (x > 0.66) show(index + 1);
    else if (x < 0.2) show(index - 1);
  });

  // Today's session code, matching the facilitator default (SB64-<date>).
  const codeEl = document.getElementById('session-code');
  if (codeEl) codeEl.textContent = `SB64-${new Date().toISOString().slice(0, 10)}`;

  show(index);
</script>
</body>
</html>

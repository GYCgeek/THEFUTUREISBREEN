<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Horizon Scanning | Global Youth Coalition</title>

<!-- GYC Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Share+Tech+Mono&family=Rajdhani:wght@300;400;500;600;700&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

<style>
/* ═══════════════════════════════════════
   LAYER 1 — GYC SHELL (header + footer)
   ═══════════════════════════════════════ */
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Montserrat', sans-serif;
  line-height: 1.7;
  background: #fff;
  color: #333;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* GYC Header — matches existing site */
.main-header {
  background: #fff;
  padding: 15px 0;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
  z-index: 10000;
  transition: transform 0.35s ease, opacity 0.35s ease;
}
.main-header.collapsed {
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
  position: absolute;
}
.gyc-close-btn {
  background: none;
  border: 1px solid #ddd;
  color: #999;
  font-size: 1.1rem;
  width: 30px; height: 30px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  margin-left: 12px;
  flex-shrink: 0;
  line-height: 1;
}
.gyc-close-btn:hover { border-color: #00a09a; color: #00a09a; }

/* Reopen button — shown when header is collapsed */
.gyc-reopen-btn {
  position: fixed;
  top: 10px;
  right: 16px;
  z-index: 10001;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.65rem;
  font-weight: 600;
  padding: 6px 14px;
  background: rgba(255,255,255,0.95);
  border: 1px solid #ddd;
  color: #00a09a;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.25s;
  display: none;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  letter-spacing: 0.03em;
}
.gyc-reopen-btn:hover {
  background: #00a09a;
  color: #fff;
  border-color: #00a09a;
}
.gyc-reopen-btn.visible { display: block; }
.main-header .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.logo a {
  text-decoration: none;
  font-size: 1.5em;
  font-weight: 700;
  color: #00a09a;
}
.main-nav ul {
  list-style: none;
  display: flex;
  align-items: center;
}
.main-nav ul li { margin-left: 20px; }
.main-nav ul li a {
  color: #333;
  text-decoration: none;
  padding-bottom: 5px;
  transition: border-bottom 0.2s, color 0.2s;
}
.main-nav ul li a:hover,
.main-nav ul li a.active {
  color: #00a09a;
  border-bottom: 2px solid #00a09a;
}
.nav-cta-button {
  background: #00a09a;
  color: #fff !important;
  padding: 8px 15px;
  border-radius: 5px;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.85em;
  letter-spacing: 0.5px;
  transition: background 0.3s;
}
.nav-cta-button:hover {
  background: #008782;
  color: #fff !important;
  text-decoration: none;
  border-bottom: none !important;
}
.header-social a {
  font-size: 1.35rem;
  color: #0077B5;
  margin-left: 20px;
  transition: color .3s;
}
.header-social a:hover { color: #00a09a; }

/* GYC Footer — matches existing site */
.main-footer {
  background: #333;
  color: #ccc;
  text-align: center;
  padding: 40px 0;
}
.footer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.footer-logos img {
  height: 50px;
  filter: brightness(0) invert(1) opacity(0.8);
  margin-bottom: 15px;
}
.main-footer p {
  font-size: 0.9em;
  margin-bottom: 10px;
  color: #aaa;
}
.social-icons { margin-top: 15px; }
.social-icons a {
  color: #ccc;
  margin: 0 10px;
  font-size: 1.2em;
  transition: color 0.3s;
}
.social-icons a:hover { color: #00a09a; }

@media (max-width: 768px) {
  .main-header .container {
    flex-direction: column;
    text-align: center;
  }
  .main-nav { margin-top: 10px; }
  .main-nav ul {
    justify-content: center;
    flex-wrap: wrap;
    padding-left: 0;
  }
  .main-nav ul li { margin: 5px 10px; }
}


/* ═══════════════════════════════════════
   LAYER 2 — HORIZON SCANNING ZONE
   Everything below lives in the dark zone
   ═══════════════════════════════════════ */
:root {
  --bg-void: #030508;
  --bg-panel: #080c12;
  --bg-panel-hover: #0c1119;
  --bg-surface: #0a0f16;
  --border-dim: #0f1a25;
  --border-mid: #152233;
  --border-bright: #1e3350;
  --green-phosphor: #00ff88;
  --green-dim: #00cc6a;
  --green-glow: rgba(0,255,136,0.15);
  --green-faint: rgba(0,255,136,0.04);
  --cyan-bright: #00e5ff;
  --cyan-dim: #0099aa;
  --amber-bright: #ffb300;
  --amber-dim: #cc8f00;
  --red-bright: #ff3d5a;
  --purple-bright: #b388ff;
  --text-primary: #c8d6e5;
  --text-secondary: #6b7d93;
  --text-muted: #3a4d63;
  --teal: #00a09a;
  --font-display: 'Orbitron', monospace;
  --font-body: 'Rajdhani', sans-serif;
  --font-mono: 'Share Tech Mono', monospace;
}

.hz-zone {
  background: var(--bg-void);
  color: var(--text-primary);
  font-family: var(--font-body);
  position: relative;
  min-height: 80vh;
}

/* Scanlines */
.hz-zone::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,255,136,0.012) 2px, rgba(0,255,136,0.012) 4px);
  pointer-events: none;
  z-index: 2;
}

/* Grid */
.hz-zone::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 20% 15%, rgba(0,255,136,0.03) 0%, transparent 50%),
    radial-gradient(circle at 85% 85%, rgba(0,229,255,0.02) 0%, transparent 50%),
    linear-gradient(rgba(0,255,136,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,255,136,0.018) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
  pointer-events: none;
  z-index: 0;
}

.hz-inner {
  position: relative;
  z-index: 1;
  max-width: 1400px;
  margin: 0 auto;
}

/* ── Transition edge: GYC → Sci-fi ── */
.hz-transition-in {
  height: 6px;
  background: linear-gradient(180deg, #fff 0%, var(--bg-void) 100%);
}
.hz-transition-out {
  height: 6px;
  background: linear-gradient(180deg, var(--bg-void) 0%, #333 100%);
}

/* ══════════════════════════
   HZ HEADER
   ══════════════════════════ */
.hz-header {
  padding: 2rem 2rem 1.5rem;
  border-bottom: 1px solid var(--border-dim);
  position: relative;
  overflow: hidden;
}
.hz-header::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0;
  width: 200px; height: 1px;
  background: linear-gradient(90deg, var(--green-phosphor), transparent);
  animation: headerScan 4s linear infinite;
}
@keyframes headerScan {
  0% { transform: translateX(-200px); }
  100% { transform: translateX(1400px); }
}

.hz-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.hz-logo-block {
  display: flex;
  align-items: center;
  gap: 1rem;
}

/* Radar */
.radar-icon {
  width: 42px; height: 42px;
  position: relative;
  flex-shrink: 0;
}
.radar-icon::before {
  content: '';
  position: absolute;
  inset: 0;
  border: 2px solid var(--green-phosphor);
  border-radius: 50%;
  opacity: 0.4;
}
.radar-icon::after {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 50%; height: 2px;
  background: var(--green-phosphor);
  transform-origin: left center;
  animation: radarSweep 3s linear infinite;
  box-shadow: 0 0 8px var(--green-phosphor);
}
@keyframes radarSweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.radar-dot {
  position: absolute;
  width: 6px; height: 6px;
  background: var(--green-phosphor);
  border-radius: 50%;
  top: 8px; right: 10px;
  box-shadow: 0 0 6px var(--green-phosphor);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.6); }
}

.hz-logo-text { display: flex; flex-direction: column; }
.hz-logo-main {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: var(--green-phosphor);
  text-shadow: 0 0 20px rgba(0,255,136,0.3);
  line-height: 1.2;
}
.hz-logo-sub {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-muted);
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.hz-status-cluster {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}
.sys-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 5px 12px;
  border-radius: 3px;
}
.sys-badge.online {
  color: var(--green-phosphor);
  background: var(--green-faint);
  border: 1px solid rgba(0,255,136,0.15);
}
.sys-badge .dot {
  width: 5px; height: 5px;
  background: var(--green-phosphor);
  border-radius: 50%;
  box-shadow: 0 0 6px var(--green-phosphor);
  animation: pulse 2s ease-in-out infinite;
}
.hz-clock {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 0.05em;
}

/* ══════════════════════════
   TAB BAR (Signals / Submit / Admin)
   ══════════════════════════ */
.hz-tabs {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 2rem;
  border-bottom: 1px solid var(--border-dim);
  margin-bottom: 0;
}
.hz-tab {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.85rem 1.5rem;
  color: var(--text-muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.2s;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
}
.hz-tab:hover { color: var(--text-secondary); }
.hz-tab.active {
  color: var(--green-phosphor);
  border-bottom-color: var(--green-phosphor);
}
.hz-tab.admin-tab { margin-left: auto; color: var(--amber-dim); }
.hz-tab.admin-tab.active { color: var(--amber-bright); border-bottom-color: var(--amber-bright); }

/* Tab panels */
.hz-panel { display: none; }
.hz-panel.active { display: block; }

/* ══════════════════════════
   STATS GRID
   ══════════════════════════ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1px;
  margin: 1.5rem 2rem;
  background: var(--border-dim);
  border: 1px solid var(--border-dim);
  border-radius: 4px;
  overflow: hidden;
}
.stat-cell {
  background: var(--bg-panel);
  padding: 1rem;
  position: relative;
  transition: background 0.2s;
}
.stat-cell:hover { background: var(--bg-panel-hover); }
.stat-value {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--green-phosphor);
  text-shadow: 0 0 12px rgba(0,255,136,0.2);
  font-variant-numeric: tabular-nums;
}
.stat-value.cyan { color: var(--cyan-bright); text-shadow: 0 0 12px rgba(0,229,255,0.2); }
.stat-value.amber { color: var(--amber-bright); text-shadow: 0 0 12px rgba(255,179,0,0.2); }
.stat-label {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-top: 3px;
}

/* ══════════════════════════
   FILTER CONTROLS
   ══════════════════════════ */
.controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 2rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.ctrl-btn {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 6px 14px;
  background: var(--bg-panel);
  border: 1px solid var(--border-dim);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.15s;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 2px;
}
.ctrl-btn:hover { border-color: var(--green-dim); color: var(--green-phosphor); }
.ctrl-btn.active {
  border-color: var(--green-phosphor);
  color: var(--green-phosphor);
  background: rgba(0,255,136,0.06);
  box-shadow: 0 0 10px rgba(0,255,136,0.08);
}
.search-wrap {
  flex: 1; min-width: 200px; max-width: 340px;
  margin-left: auto;
  position: relative;
}
.search-wrap::before {
  content: '>';
  position: absolute; left: 12px; top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--green-dim);
  opacity: 0.5;
}
.search-wrap input {
  width: 100%;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  padding: 8px 14px 8px 28px;
  background: var(--bg-panel);
  border: 1px solid var(--border-dim);
  color: var(--text-primary);
  outline: none;
  border-radius: 2px;
  transition: all 0.15s;
  caret-color: var(--green-phosphor);
}
.search-wrap input::placeholder { color: var(--text-muted); }
.search-wrap input:focus { border-color: var(--green-dim); box-shadow: 0 0 12px rgba(0,255,136,0.06); }

/* ══════════════════════════
   SIGNAL CARDS
   ══════════════════════════ */
.feed { padding: 0 2rem 3rem; }

.date-divider {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.75rem 0 0.75rem;
}
.date-divider-text {
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  color: var(--cyan-bright);
  text-transform: uppercase;
  white-space: nowrap;
  text-shadow: 0 0 10px rgba(0,229,255,0.2);
}
.date-divider-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--border-mid), transparent); }
.date-theme {
  font-family: var(--font-mono);
  font-size: 0.6rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.signal {
  background: var(--bg-panel);
  border: 1px solid var(--border-dim);
  border-left: 3px solid var(--border-dim);
  margin-bottom: 8px;
  padding: 1.4rem 1.75rem;
  border-radius: 2px;
  transition: all 0.25s;
  position: relative;
  overflow: hidden;
  animation: signalIn 0.4s ease-out both;
}
.signal::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, var(--green-faint), transparent 30%);
  opacity: 0;
  transition: opacity 0.25s;
}
.signal:hover { border-color: var(--border-mid); background: var(--bg-panel-hover); transform: translateX(3px); }
.signal:hover::before { opacity: 1; }
.signal.conf-High { border-left-color: var(--green-phosphor); }
.signal.conf-Medium { border-left-color: var(--amber-bright); }
.signal.conf-Low { border-left-color: var(--red-bright); }

@keyframes signalIn {
  from { opacity: 0; transform: translateX(-12px); }
  to { opacity: 1; transform: translateX(0); }
}

.signal-header {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 0.6rem;
  position: relative;
  z-index: 1;
}
.signal-id {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--cyan-dim);
  background: rgba(0,229,255,0.05);
  border: 1px solid rgba(0,229,255,0.1);
  padding: 4px 10px;
  border-radius: 2px;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 4px;
}
.signal-title {
  flex: 1;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 1.2rem;
  line-height: 1.45;
}
.signal-conf-badge {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  padding: 4px 10px;
  border-radius: 2px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  flex-shrink: 0;
  margin-top: 4px;
}
.badge-High { color: var(--green-phosphor); background: rgba(0,255,136,0.08); border: 1px solid rgba(0,255,136,0.15); }
.badge-Medium { color: var(--amber-bright); background: rgba(255,179,0,0.08); border: 1px solid rgba(255,179,0,0.15); }
.badge-Low { color: var(--red-bright); background: rgba(255,61,90,0.08); border: 1px solid rgba(255,61,90,0.15); }

.signal-body { position: relative; z-index: 1; }

.signal-content-row { display: flex; gap: 1.25rem; align-items: flex-start; }
.signal-img-wrap {
  flex-shrink: 0;
  width: 160px; height: 100px;
  border-radius: 3px;
  overflow: hidden;
  border: 1px solid var(--border-dim);
  background: var(--bg-surface);
}
.signal-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(0.85) brightness(0.9);
  transition: filter 0.3s, transform 0.3s;
}
.signal:hover .signal-img-wrap img { filter: saturate(1) brightness(1); transform: scale(1.03); }
.signal-img-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 0.55rem;
  color: var(--text-muted);
  text-transform: uppercase;
  background: linear-gradient(135deg, var(--bg-surface), var(--bg-panel));
}
.signal-text-col { flex: 1; min-width: 0; }

.signal-summary { font-size: 1rem; line-height: 1.7; color: var(--text-secondary); margin-bottom: 0.6rem; }

.signal-why {
  font-size: 0.95rem; line-height: 1.65; color: var(--text-secondary);
  padding: 0.75rem 1rem;
  background: rgba(0,229,255,0.02);
  border-left: 2px solid var(--border-mid);
  border-radius: 0 2px 2px 0;
  margin-bottom: 0.75rem;
}
.signal-why em {
  color: var(--cyan-dim); font-style: normal; font-size: 0.72rem;
  font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em;
  display: block; margin-bottom: 4px;
}

.signal-meta {
  display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
  font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);
}
.signal-meta a { color: var(--cyan-dim); text-decoration: none; transition: color 0.15s; }
.signal-meta a:hover { color: var(--cyan-bright); }

.signal-status { display: inline-flex; align-items: center; gap: 4px; }
.status-dot {
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--green-phosphor);
  box-shadow: 0 0 4px var(--green-phosphor);
}
.status-dot.inactive { background: var(--text-muted); box-shadow: none; }

.signal-update-note {
  margin-top: 0.6rem;
  font-family: var(--font-mono); font-size: 0.8rem; color: var(--amber-dim);
  padding: 0.5rem 0.85rem;
  background: rgba(255,179,0,0.03);
  border-left: 2px solid rgba(255,179,0,0.2);
  border-radius: 0 2px 2px 0;
}

/* ══════════════════════════
   SUBMIT SIGNAL FORM
   ══════════════════════════ */
.submit-panel { padding: 2rem; }
.submit-panel h2 {
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--cyan-bright);
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.submit-panel p.form-desc {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
  line-height: 1.5;
}

.hz-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  max-width: 800px;
}
.hz-form .full-width { grid-column: 1 / -1; }

.hz-field label {
  display: block;

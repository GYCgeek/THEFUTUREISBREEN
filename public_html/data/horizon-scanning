<!-- Transition: white → dark -->
<div class="hz-transition-in"></div>

<!-- ═══════════════════════════════════
     HORIZON SCANNING ZONE
     ═══════════════════════════════════ -->
<div class="hz-zone">
<div class="hz-inner">

  <!-- HZ Header -->
  <header class="hz-header">
    <div class="hz-header-row">
      <div class="hz-logo-block">
        <div class="radar-icon"><div class="radar-dot"></div></div>
        <div class="hz-logo-text">
          <div class="hz-logo-main">FORESIGHT</div>
          <div class="hz-logo-sub">Horizon Scanning Network</div>
        </div>
      </div>
      <div class="hz-status-cluster">
        <div class="sys-badge online"><span class="dot"></span><span>System Online</span></div>
        <div class="hz-clock" id="clockReadout"></div>
      </div>
    </div>
  </header>

  <!-- Tab Bar -->
  <div class="hz-tabs">
    <button class="hz-tab active" onclick="switchTab('signals', this)">Signals</button>
    <button class="hz-tab" onclick="switchTab('submit', this)">Submit Signal</button>
    <button class="hz-tab admin-tab" onclick="switchTab('admin', this)">Review Queue</button>
  </div>

  <!-- ═══ TAB: SIGNALS ═══ -->
  <div class="hz-panel active" id="panel-signals">
    <div class="stats-grid">
      <div class="stat-cell"><div class="stat-value" id="sTotal">--</div><div class="stat-label">Signals Tracked</div></div>
      <div class="stat-cell"><div class="stat-value cyan" id="sActive">--</div><div class="stat-label">Active</div></div>
      <div class="stat-cell"><div class="stat-value" id="sHigh">--</div><div class="stat-label">High Confidence</div></div>
      <div class="stat-cell"><div class="stat-value amber" id="sMedium">--</div><div class="stat-label">Medium</div></div>
      <div class="stat-cell"><div class="stat-value cyan" id="sSources">--</div><div class="stat-label">Unique Sources</div></div>
      <div class="stat-cell"><div class="stat-value" id="sUpdated">--</div><div class="stat-label">Last Sync</div></div>
    </div>

    <div class="controls">
      <button class="ctrl-btn active" onclick="setFilter('all',this)">ALL</button>
      <button class="ctrl-btn" onclick="setFilter('High',this)">HIGH</button>
      <button class="ctrl-btn" onclick="setFilter('Medium',this)">MED</button>
      <button class="ctrl-btn" onclick="setFilter('Low',this)">LOW</button>
      <button class="ctrl-btn" onclick="setFilter('active',this)">ACTIVE</button>
      <div class="search-wrap">
        <input type="text" id="searchInput" placeholder="search signals..." oninput="debounceSearch()">
      </div>
    </div>

    <div class="feed" id="signalFeed">
      <div class="loading-state"><div class="loader-ring"></div>Scanning the horizon...</div>
    </div>

    <!-- Community submitted signals (in review) -->
    <div class="community-section" id="communitySection" style="display:none;">
      <div class="community-header" onclick="toggleCommunity()">
        <span class="community-header-text">Community Submitted — In Review</span>
        <span class="community-header-line"></span>
        <span class="community-count" id="communityCount">0 pending</span>
        <span class="community-toggle" id="communityArrow">▼</span>
      </div>
      <div class="community-feed" id="communityFeed"></div>
    </div>
  </div>

  <!-- ═══ TAB: SUBMIT SIGNAL ═══ -->
  <div class="hz-panel" id="panel-submit">
    <div class="submit-panel">
      <h2>Submit a Signal</h2>
      <p class="form-desc">Spotted something relevant to intergenerational equity? Submit it here for the research team to review. Approved signals will appear on the public feed.</p>

      <div class="hz-form" id="submitForm">
        <div class="hz-field full-width">
          <label>Signal Title *</label>
          <input type="text" id="f-title" placeholder="e.g. UK Wellbeing of Future Generations Bill progressing">
        </div>
        <div class="hz-field">
          <label>Source URL</label>
          <input type="url" id="f-source-url" placeholder="https://...">
        </div>
        <div class="hz-field">
          <label>Source Name</label>
          <input type="text" id="f-source-name" placeholder="e.g. UK Parliament">
        </div>
        <div class="hz-field">
          <label>Topic / Theme</label>
          <input type="text" id="f-topic" placeholder="e.g. Future generations legislation">
        </div>
        <div class="hz-field">
          <label>Confidence</label>
          <select id="f-confidence">
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Low">Low</option>
          </select>
        </div>
        <div class="hz-field full-width">
          <label>Summary *</label>
          <textarea id="f-summary" placeholder="Brief description of the signal (2-3 sentences)"></textarea>
        </div>
        <div class="hz-field full-width">
          <label>Why it matters</label>
          <textarea id="f-why" placeholder="Strategic significance for intergenerational equity"></textarea>
        </div>
        <div class="hz-field full-width">
          <label>Submitted by</label>
          <input type="text" id="f-author" placeholder="Your name (optional)">
        </div>
        <div class="hz-field full-width">
          <button class="hz-submit-btn" onclick="submitSignal()">Submit for Review</button>
        </div>
      </div>
      <div class="submit-success" id="submitSuccess">
        ✓ Signal submitted for review. The research team will evaluate it before publishing.
      </div>
    </div>
  </div>

  <!-- ═══ TAB: ADMIN REVIEW ═══ -->
  <div class="hz-panel" id="panel-admin">
    <div class="admin-panel">
      <!-- Login gate -->
      <div class="admin-login" id="adminLogin">
        <label>Admin Password</label>
        <input type="password" id="adminPass" placeholder="Enter review password" onkeydown="if(event.key==='Enter')adminAuth()">
        <br>
        <button class="admin-login-btn" onclick="adminAuth()">Authenticate</button>
        <div class="admin-error" id="adminError">Invalid password</div>
      </div>

      <!-- Queue (hidden until auth) -->
      <div class="admin-queue" id="adminQueue">
        <h2>Pending Review Queue</h2>

     GYC FOOTER (matches existing site)
     ═══════════════════════════════════ -->
<footer class="main-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-logos">
        <img src="https://theglobalyouth.co/assets/images/global_logo1.png" alt="Global Youth Coalition Logo">

  .timeline-inner{max-width:900px;margin:0 auto}
  .timeline .section-title{color:#fff}
  .timeline .section-subtitle{color:rgba(255,255,255,.7)}
  .timeline-list{display:flex;flex-direction:column;gap:16px;margin-top:32px}
  .timeline-item{display:flex;align-items:center;gap:20px;padding:16px 20px;background:rgba(255,255,255,.06);border-radius:12px;border-left:3px solid #fffb80}
  .timeline-item .date{font-family:'Share Tech Mono',monospace;font-size:13px;color:#fffb80;min-width:100px;font-weight:700}
  .timeline-item .desc{font-size:14px;color:rgba(255,255,255,.85)}

  /* ── FUNDER CTA ── */

  .testimonial-inner{max-width:700px;margin:0 auto;text-align:center}
  .testimonial blockquote{font-size:20px;font-style:italic;color:#003b4a;line-height:1.6;margin-bottom:12px}
  .testimonial cite{font-size:14px;color:#557580;font-style:normal}
